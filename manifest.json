{
    "manifest_version": 3,
    "name": "ApvGuessr",
    "version": "0.5",
    "description": "Enhance your game experience",
    "icons": {
        "128": "assets/APV_GUESSR_LOGO.png"
    },
    "permissions": [
        "debugger"
    ],
    "host_permissions": [
        "https://www.geoguessr.com/*"
    ],
    "background": {
        "service_worker": "dist/background.js"
    },
    "web_accessible_resources": [
        {
            "resources": [
                "assets/view.png"
            ],
            "matches": [
                "https://www.geoguessr.com/*"
            ]
        }
    ],
    "content_scripts": [
        {
            "matches": [
                "https://www.geoguessr.com/*"
            ],
            "js": [
                "dist/content.js"
            ],
            "run_at": "document_start"
        }
    ]
}
