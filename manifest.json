{
    "manifest_version": 3,
    "name": "ApvGuessr",
    "version": "0.5",
    "description": "Enhance your game experience",
    "icons": {
        "128": "assets/APV_GUESSR_LOGO.png"
    },
    "permissions": [
        "debugger",
        "storage"
    ],
    "host_permissions": [
        "https://www.geoguessr.com/*"
    ],
    "background": {
        "service_worker": "dist/background.js"
    },
    "commands": {
        "show-location": {
            "suggested_key": {
                "default": "Ctrl+Shift+Y",
                "mac": "Command+MacCtrl+D"
            },
            "description": "Show the location of the current round"
        }
    }
}
